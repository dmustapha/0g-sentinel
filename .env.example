# File: .env.example

# 0G Chain
ZERO_G_RPC=https://evmrpc.0g.ai
ZERO_G_RPC_TESTNET=https://evmrpc-testnet.0g.ai

# 0G Compute (get key at https://pc.0g.ai — connect wallet, pick model, Generate New Key)
ZERO_G_COMPUTE_URL=https://router-api.0g.ai/v1
ZERO_G_COMPUTE_API_KEY=your_compute_api_key_here

# 0G Storage
ZERO_G_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
ZERO_G_PRIVATE_KEY=your_private_key_for_storage_uploads

# Deployment
DEPLOYER_PRIVATE_KEY=your_deployer_private_key
SCANNER_PRIVATE_KEY=your_scanner_private_key
SCANNER_ADDRESS=your_scanner_address

# ProofLock V2 deployment (all nine values are required; roles must be distinct)
PROOFLOCK_ADMIN_ADDRESS=
PROOFLOCK_SCANNER_ADDRESS=
PROOFLOCK_GUARDIAN_ADDRESS=
PROOFLOCK_MAX_BEHAVIORAL_SCORE=50
PROOFLOCK_MAX_CODE_RISK=1
PROOFLOCK_REQUIRED_COVERAGE=127
PROOFLOCK_MINIMUM_POLICY_VERSION=1
PROOFLOCK_MAXIMUM_AGE_SECONDS=604800
PROOFLOCK_DEPLOY_CONFIRMATIONS=3

# Contract Addresses (populated by deploy scripts)
ATTESTATION_REGISTRY_ADDRESS=
AGENT_REGISTRY_ADDRESS=
AGENT_GATE_ADDRESS=

# Demo Agent Addresses (populated after seed deploy)
AGENT_A_ADDRESS=
AGENT_B_ADDRESS=
AGENT_C_ADDRESS=
AGENT_D_ADDRESS=
AGENT_E_ADDRESS=

# Optional: Pre-set known contract sources JSON for scanner
KNOWN_CONTRACT_SOURCES={}

# Demo Agent Addresses F-H (optional — extend the agent grid)
AGENT_F_ADDRESS=
AGENT_G_ADDRESS=
AGENT_H_ADDRESS=

# Active ProofLock V2 frontend public vars
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RPC_URL=https://evmrpc.0g.ai
NEXT_PUBLIC_PROOFLOCK_REGISTRY_V2_ADDRESS=
NEXT_PUBLIC_AGENT_GATE_V2_ADDRESS=
NEXT_PUBLIC_PROOFLOCK_CONSUMER_ADDRESS=
NEXT_PUBLIC_PROOFLOCK_VALIDATOR_ADDRESS=
NEXT_PUBLIC_PROOFLOCK_VALIDATOR_VERSION=sentinel-prooflock-v2
NEXT_PUBLIC_PROOFLOCK_POLICY_VERSION=1
NEXT_PUBLIC_PROOFLOCK_ADMIN_ADDRESS=
NEXT_PUBLIC_PROOFLOCK_SCANNER_ADDRESS=
NEXT_PUBLIC_PROOFLOCK_GUARDIAN_ADDRESS=
NEXT_PUBLIC_PROOFLOCK_CUSTODY_CONSTRAINT=admin-scanner-guardian-must-remain-distinct
# Optional and unmistakably labeled in the UI.
NEXT_PUBLIC_PROOFLOCK_DEMO_AGENT_ID=

# Legacy V1 public vars. Excluded from ProofLock V2 admission.
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_AGENT_GATE_ADDRESS=

# ProofLock v2 operator and read-only health configuration
PROOFLOCK_REGISTRY_V2_ADDRESS=
PROOFLOCK_REGISTRY_V2_FROM_BLOCK=0
PROOFLOCK_AGENT_GATE_V2_ADDRESS=
PROOFLOCK_CONSUMER_ADDRESS=
# Generate with: openssl rand -base64 48 (required 32..256 UTF-8 bytes; server-only)
PROOFLOCK_OPERATOR_TOKEN=
PROOFLOCK_OPERATOR_MODULE=
PROOFLOCK_COMPUTE_PROVIDER=
PROOFLOCK_COMPUTE_MODEL=
PROOFLOCK_STORAGE_FLOW_ADDRESS=0x62D4144dB0F0a6fBBaeb6296c785C71B3D57C526
PROOFLOCK_STORAGE_FLOW_FROM_BLOCK=0
PROOFLOCK_STORAGE_CONFIRMATIONS=3
PROOFLOCK_HEALTH_AGENT_ID=
PROOFLOCK_HEALTH_IDENTITY_KEY=
PROOFLOCK_STORAGE_CANARY_ROOT=
NEXT_PUBLIC_ZERO_G_EXPLORER=https://chainscan.0g.ai
