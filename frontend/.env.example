# 0G Sentinel Frontend — Environment Variables
# Copy to .env.local and fill in values

# Public (exposed to browser)
NEXT_PUBLIC_APP_URL=https://your-deployment-url.vercel.app
NEXT_PUBLIC_RPC_URL=https://evmrpc.0g.ai
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=0xB9431b3be9a56a1eeA8E728326332f8B4dD51382
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=0x5F6a3AbC97E421f7B3930fc504D6a0CE4eE41e06
NEXT_PUBLIC_AGENT_GATE_ADDRESS=0x8E107bAC6f430aecB8Aa11B383E9690e9a5214bE

# Server-side only (API routes)
ZERO_G_RPC=https://evmrpc.0g.ai
ZERO_G_COMPUTE_URL=https://router-api.0g.ai/v1
ZERO_G_COMPUTE_API_KEY=your-0g-compute-api-key
ZERO_G_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
ZERO_G_PRIVATE_KEY=your-64-char-hex-private-key
SCANNER_PRIVATE_KEY=your-64-char-hex-private-key
ATTESTATION_REGISTRY_ADDRESS=0xB9431b3be9a56a1eeA8E728326332f8B4dD51382
AGENT_REGISTRY_ADDRESS=0x5F6a3AbC97E421f7B3930fc504D6a0CE4eE41e06
AGENT_GATE_ADDRESS=0x8E107bAC6f430aecB8Aa11B383E9690e9a5214bE

# Demo agent addresses (seeded by scripts/seed-demo.ts)
AGENT_A_ADDRESS=0xAAAA000000000000000000000000000000000001
AGENT_B_ADDRESS=0xBBBB000000000000000000000000000000000002
AGENT_C_ADDRESS=0xCCCC000000000000000000000000000000000003
