{
  "name": "0g-sentinel-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prooflock:worker": "node scripts/bundle-prooflock-worker.mjs",
    "predev": "npm run prooflock:worker",
    "dev": "next dev",
    "prebuild": "npm run prooflock:worker",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:prooflock": "vitest run tests/prooflock",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:mocked": "node scripts/run-playwright.mjs --project=chromium-mocked --project=firefox-mocked --project=webkit-mocked",
    "test:e2e:visual": "node scripts/run-playwright.mjs --project=chromium-mocked --project=chromium-visual --grep @visual",
    "test:e2e:visual:update": "node scripts/run-playwright.mjs --project=chromium-mocked --project=chromium-visual --grep @visual --update-snapshots",
    "test:e2e:full": "node scripts/run-playwright.mjs",
    "test:e2e:standalone": "node scripts/run-playwright.mjs --project=standalone-smoke",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:install:ci": "playwright install --with-deps chromium firefox webkit",
    "test:standalone": "node scripts/test-standalone.mjs",
    "test:release": "node scripts/test-release.mjs"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "^0.9.0",
    "@0gfoundation/0g-storage-ts-sdk": "1.2.11",
    "@vercel/functions": "^3.6.0",
    "dotenv": "^16.0.0",
    "ethers": "^6.13.0",
    "json-canonicalize": "^3.0.0",
    "lossless-json": "^4.3.1",
    "next": "14.2.35",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
