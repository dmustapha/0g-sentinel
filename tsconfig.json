{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "paths": {
      "@scanner/*": ["./scanner/*"]
    }
  },
  "include": ["contracts/**/*", "scripts/**/*", "scanner/**/*", "tests/**/*", "hardhat.config.ts"],
  "exclude": ["node_modules", "frontend", "dist"]
}
